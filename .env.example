# Banco de dados
DATABASE_URL=sqlite:///./data/confeitaria.db

# Autenticação simples (single-user)
APP_USERNAME=admin
APP_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-longa
JWT_EXPIRE_MINUTES=60

# OCR (API externa) — obtenha uma chave gratuita em https://ocr.space/ocrapi
OCR_PROVIDER=ocr_space
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image

# CORS — em produção, restrinja ao domínio do frontend
CORS_ORIGINS=*
