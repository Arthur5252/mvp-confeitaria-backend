# Banco de dados
URL_BANCO=sqlite:///./data/confeitaria.db

# Autenticação simples (usuário único)
# Credenciais de AVALIAÇÃO (públicas). Em uso real, troque a senha e o segredo.
USUARIO_APP=avaliador
SENHA_APP=confeitaria123
SEGREDO_JWT=segredo-de-avaliacao-troque-em-uso-real
EXPIRACAO_JWT_MINUTOS=60

# OCR (API externa) — obtenha uma chave gratuita em https://ocr.space/ocrapi
PROVEDOR_OCR=ocr_space
CHAVE_API_OCR_SPACE=
ENDPOINT_OCR_SPACE=https://api.ocr.space/parse/image

# CORS — em produção, restrinja ao domínio do frontend
ORIGENS_CORS=*
